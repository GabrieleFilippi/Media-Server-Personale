# === Media Server - Configurazione ===

# Percorso root del disco dedicato ai media
# Esempio: /mnt/media, /srv/media, /data
MEDIA_ROOT=/mnt/media

# Directory derivate (normalmente non serve modificarle)
DOWNLOADS_DIR=${MEDIA_ROOT}/downloads
MOVIES_DIR=${MEDIA_ROOT}/movies
TV_DIR=${MEDIA_ROOT}/tv

# Directory configurazioni dei servizi (relativa al progetto)
CONFIG_DIR=./config

# Utente e gruppo per i permessi dei container
# Trova i tuoi valori con: id
PUID=1000
PGID=1000

# Timezone
TZ=Europe/Rome

# === Accesso Esterno ===

# Indirizzo IP Tailscale del server (100.x.x.x)
# Trova il tuo IP con: tailscale ip -4
# Usato per esporre i servizi admin SOLO via Tailscale
TAILSCALE_IP=100.x.x.x

# Dominio pubblico per Jellyfin (es: jellyfin.tuodominio.com o tuonome.duckdns.org)
DOMAIN=jellyfin.example.com
